# OpenAI API配置
OPENAI_API_KEY=your_openai_api_key_here

# 数据库配置
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

# MongoDB配置
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password
MONGO_DATABASE=tracking_db

# Grafana配置
GRAFANA_PASSWORD=admin

# 服务端口配置
OSS_MONITOR_PORT=5001
TRACKING_API_PORT=5002
VIDEO_WATERMARK_PORT=5003

# 日志级别
LOG_LEVEL=INFO

# 安全配置
API_KEY=your_secure_api_key_here
JWT_SECRET=your_jwt_secret_here

# 外部服务配置
REDIS_URL=redis://redis:6379
MYSQL_URL=mysql://app_user:app_password@mysql:3306/app_db
MONGODB_URL=mongodb://admin:password@mongodb:27017/tracking_db